{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/pr-self-review-gate.sh\"",
            "if": "Bash(git push:*)",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/pr-self-review-gate.sh\"",
            "if": "Bash(gh pr create:*)",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
